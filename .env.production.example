# ============================================================
# ENVIRONMENT PRODUKSI BACKEND - NEXT KARYA
# Salin berkas ini menjadi `backend/.env.production` di server.
# Jangan commit berkas hasil salinan.
#
# JWT_SECRET dan WEBHOOK_SECRET sengaja tidak ada di sini: docker compose
# menyuntikkannya dari `.env` di direktori compose agar nilainya sama dengan
# frontend. Jika backend dijalankan tanpa compose, isi keduanya secara manual.
# ============================================================

PORT="5000"
NODE_ENV="production"

# Supabase Postgres - Session Pooler, port 5432.
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres?sslmode=require"

# Redis berjalan sebagai container di jaringan compose.
REDIS_URL="redis://redis:6379"

# Dipakai backend untuk CORS dan webhook revalidasi frontend.
FRONTEND_URL="https://nextkarya.web.id"

SITE_ID="nextkarya-main"
UPLOAD_DIR="./uploads"

# Akun yang boleh mengelola anggota tim dan mengatur ulang kata sandi staf.
# Pisahkan dengan koma jika lebih dari satu.
STAFF_ADMIN_EMAILS="programmer@nextkarya.web.id"

# ============================================================
# SUPABASE STORAGE - DIRECT UPLOAD
# Buat bucket publik `nextkarya-media`, atau jalankan:
#   npm run storage:check -- --create-bucket
# Service role key hanya boleh ada di backend, jangan di frontend.
# SUPABASE_URL memakai alamat dasar project, tanpa /rest/v1.
# SUPABASE_STORAGE_PUBLIC_URL memakai URL public object, bukan endpoint S3.
# ============================================================
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_STORAGE_BUCKET="nextkarya-media"
SUPABASE_STORAGE_PUBLIC_URL="https://<PROJECT_REF>.supabase.co/storage/v1/object/public/nextkarya-media"
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS="900"

# Kata sandi awal tiga akun staf saat seed pertama di production.
# Minimal 8 karakter. Ganti setelah login pertama.
# Jangan menjalankan seed lagi setelah konten produksi diedit.
SEED_DEFAULT_PASSWORD="#SolusiAtasiManualProses-NextKaryaSolutions2026_ID"

# Jalur darurat rotasi kata sandi tanpa menjalankan seed konten:
#   npm run db:seed-passwords
# Isi hanya akun yang ingin diubah. Minimal 12 karakter per akun.
# SEED_PASSWORD_PROGRAMMER="<MINIMAL_12_KARAKTER>"
# SEED_PASSWORD_DESIGNER="<MINIMAL_12_KARAKTER>"
# SEED_PASSWORD_LEAD="<MINIMAL_12_KARAKTER>"
