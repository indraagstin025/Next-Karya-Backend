# ============================================================
# SUPABASE POSTGRES - NEXT KARYA BACKEND
# Salin file ini menjadi .env setelah semua nilai diisi.
# Jangan commit file .env.
# ============================================================

PORT=5000
NODE_ENV=development

# Supabase Dashboard > Project Settings > Database > Connection string
# Untuk Express + Prisma, gunakan Session Pooler (port 5432).
# Ganti <PROJECT_REF>, <PASSWORD>, dan <REGION>.
# Jika password mengandung karakter khusus, URL-encode nilainya.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Alternatif: Transaction Pooler untuk runtime dan Session Pooler untuk migrasi.
# Aktifkan dua baris ini hanya jika prisma/schema.prisma memakai directUrl.
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase tidak menyediakan Redis. Untuk development, Redis lokal cukup.
# Jika Redis tidak tersedia, backend memakai fallback cache in-memory.
REDIS_URL="redis://localhost:6379"

# Buat nilai acak baru, misalnya: openssl rand -hex 32
JWT_SECRET="<MINIMAL_32_KARAKTER>"
WEBHOOK_SECRET="<MINIMAL_16_KARAKTER>"

FRONTEND_URL="http://localhost:3000"
SITE_ID="nextkarya-main"

# Kata sandi awal untuk tiga akun staf saat seed pertama.
# Wajib diisi saat NODE_ENV=production. Ganti setelah login pertama.
# SEED_DEFAULT_PASSWORD="<MINIMAL_8_KARAKTER>"

# Fallback media lokal. Dipakai hanya jika STORAGE_DRIVER="local".
UPLOAD_DIR="./uploads"

# ============================================================
# SUPABASE STORAGE - DIRECT UPLOAD
# Buat bucket publik bernama nextkarya-media di Supabase Dashboard,
# atau jalankan: npm run storage:check -- --create-bucket
# Service role key hanya boleh ada di backend, jangan di frontend.
# SUPABASE_URL memakai alamat dasar project, tanpa /rest/v1.
# SUPABASE_STORAGE_PUBLIC_URL memakai URL public object, bukan endpoint S3.
# ============================================================
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_STORAGE_BUCKET="nextkarya-media"
SUPABASE_STORAGE_PUBLIC_URL="https://<PROJECT_REF>.supabase.co/storage/v1/object/public/nextkarya-media"
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS="900"
