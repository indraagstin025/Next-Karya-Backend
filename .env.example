# Untuk Supabase, gunakan template .env.supabase.example.
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextkarya?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="nextkarya-development-jwt-secret-key-minimum-32-chars"
# Opsional. Salt khusus hash pengunjung harian. Jika kosong, JWT_SECRET dipakai.
# ANALYTICS_SALT_SECRET="<MINIMAL_32_KARAKTER>"
WEBHOOK_SECRET="nextkarya-webhook-secret-key-minimum-32-chars"
FRONTEND_URL="http://localhost:3000"
SITE_ID="nextkarya-main"
UPLOAD_DIR="./uploads"

# Daftar email yang mendapat akses pengelolaan anggota dan kata sandi.
# Pisahkan dengan koma jika lebih dari satu.
STAFF_ADMIN_EMAILS="programmer@nextkarya.web.id"

# Kata sandi awal untuk tiga akun staf saat seed pertama.
# Wajib diisi saat NODE_ENV=production. Ganti setelah login pertama.
# SEED_DEFAULT_PASSWORD="<MINIMAL_8_KARAKTER>"
# SEED_PASSWORD_PROGRAMMER="<MINIMAL_12_KARAKTER>"
# SEED_PASSWORD_DESIGNER="<MINIMAL_12_KARAKTER>"
# SEED_PASSWORD_LEAD="<MINIMAL_12_KARAKTER>"

# Media default disimpan di disk lokal. Untuk direct upload ke Supabase
# Storage, gunakan template .env.supabase.example.
STORAGE_DRIVER="local"
# SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
# SUPABASE_STORAGE_BUCKET="nextkarya-media"
# SUPABASE_STORAGE_PUBLIC_URL="https://<PROJECT_REF>.supabase.co/storage/v1/object/public/nextkarya-media"
# SUPABASE_SIGNED_UPLOAD_TTL_SECONDS="900"
